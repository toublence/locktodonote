          }
        }
      }
    },
    "intent.limitReached": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've used all free Shortcut adds today. Upgrade to Pro for unlimited adds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast heute alle kostenlosen Kurzbefehle verbraucht. Mit Pro kannst du unbegrenzt hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has usado todas las adiciones gratuitas de Atajos de hoy. Actualiza a Pro para añadir sin límites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez utilisé tous les ajouts gratuits par raccourci aujourd’hui. Passez à Pro pour des ajouts illimités."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के सभी मुफ़्त शॉर्टकट जोड़ने की सीमा पूरी हो गई है। असीमित जोड़ने के लिए Pro लें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日の無料ショートカット追加回数を使い切りました。Proなら無制限に追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 무료 단축어 추가 횟수를 모두 사용했어요. Pro에서는 무제한으로 추가할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的免费快捷指令添加次数已用完。升级到 Pro 即可无限添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的免費捷徑新增次數已用完。升級至 Pro 即可無限新增。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد استخدمت جميع إضافات الاختصارات المجانية اليوم. الترقية إلى Pro للحصول على عدد غير محدود من الإضافات."
          }
        }
      }
    },
