{
  "sourceLanguage": "en",
  "strings": {
    "widget.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See today's todos and memos on your Lock Screen and Home Screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh deine heutigen Aufgaben und Notizen auf dem Sperr- und Home-Bildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta las tareas y notas de hoy en la pantalla bloqueada y de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les tâches et notes du jour sur l’écran verrouillé et l’écran d’accueil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के कार्य और नोट लॉक स्क्रीन और होम स्क्रीन पर देखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のToDoとメモをロック画面とホーム画面で確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 할 일과 메모를 잠금 화면과 홈 화면에서 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁定屏幕和主屏幕上查看今天的待办事项和备忘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在鎖定畫面和主畫面上查看今天的待辦事項和備忘。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض مهام اليوم وملاحظاته على شاشة القفل والشاشة الرئيسية."
          }
        }
      }
    },
    "intent.emptyText": {
