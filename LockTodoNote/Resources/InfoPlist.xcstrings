    "NSUserTrackingUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالتتبع لمساعدتنا على قياس أداء الإعلانات وتحسين LockTodoNote."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Tracking, damit wir die Werbeleistung messen und LockTodoNote verbessern können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow tracking to help us measure advertising performance and improve LockTodoNote."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el seguimiento para ayudarnos a medir el rendimiento de la publicidad y mejorar LockTodoNote."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez le suivi pour nous aider à mesurer les performances publicitaires et à améliorer LockTodoNote."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विज्ञापन के प्रदर्शन को मापने और LockTodoNote को बेहतर बनाने में हमारी मदद के लिए ट्रैकिंग की अनुमति दें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広告効果の測定とLockTodoNoteの改善のために、トラッキングを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "광고 성과를 측정하고 LockTodoNote를 개선할 수 있도록 추적을 허용해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许跟踪，以帮助我们衡量广告效果并改进 LockTodoNote。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許追蹤，以協助我們衡量廣告成效並改進 LockTodoNote。"
          }
        }
      }
    }
  },
  "version" : "1.0"
