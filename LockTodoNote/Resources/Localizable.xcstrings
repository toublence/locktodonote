    "settings.shortcutTargetDetail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo sollen mit Verknüpfungen hinzugefügte Inhalte gespeichert werden? Gemischte Vorlagen verwenden diese Auswahl; Einzelinhaltsvorlagen werden automatisch ausgewählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dónde se debe guardar el contenido agregado con accesos directos? Las plantillas mixtas utilizan esta opción; Las plantillas de contenido único se eligen automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où le contenu ajouté avec les raccourcis doit-il être enregistré ? Les modèles mixtes utilisent ce choix ; les modèles à contenu unique choisissent automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट के साथ जोड़ी गई सामग्री को कहाँ सहेजा जाना चाहिए? मिश्रित टेम्पलेट इस विकल्प का उपयोग करते हैं; एकल-सामग्री टेम्पलेट स्वचालित रूप से चुने जाते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットで追加したコンテンツはどこに保存すればよいですか?混合テンプレートではこの選択を使用します。単一コンテンツのテンプレートは自動的に選択されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로가기로 추가된 콘텐츠는 어디에 저장해야 합니까? 혼합 템플릿은 이 선택을 사용합니다. 단일 콘텐츠 템플릿이 자동으로 선택됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用快捷方式添加的内容应该保存在哪里？混合模板使用此选择；自动选择单一内容模板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用快捷方式新增的內容應該保存在哪裡？混合模板使用此選擇；自動選擇單一內容模板。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أين يجب حفظ المحتوى المضاف باستخدام الاختصارات؟ تستخدم القوالب المختلطة هذا الاختيار؛ يتم اختيار القوالب ذات المحتوى الفردي تلقائيًا."
          }
        }
      }
    },
