    "onboarding.firstTodo.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fang klein an. Mehr kannst du später hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza por algo pequeño. Podrás añadir más luego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez petit. Vous pourrez en ajouter d’autres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटी शुरुआत करें। बाद में और जोड़ सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さなことから始めましょう。あとから追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 것부터 시작하세요. 나중에 더 추가할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从小事开始，之后还可以再添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從小事開始，之後還可以再新增。"
          }
