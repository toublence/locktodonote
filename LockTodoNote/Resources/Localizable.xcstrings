    "storage.readFailed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gesicherten Einträge konnten nicht geladen werden. Gelöscht wurden sie nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido cargar tus elementos guardados. No se han eliminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos éléments enregistrés n’ont pas pu être chargés. Ils n’ont pas été supprimés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सेव किए आइटम लोड नहीं हो सके। वे हटाए नहीं गए हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された項目を読み込めませんでした。削除されたわけではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 항목을 불러오지 못했어요. 삭제된 것은 아니에요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载已保存的内容，但它们并未被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入已儲存的內容，但它們並未被刪除。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تحميل العناصر المحفوظة الخاصة بك. لم يتم حذفها."
          }
        }
      }
    },
    "storage.writeFailed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Änderung konnte nicht gesichert werden. Öffne die App neu, bevor du weiterarbeitest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
