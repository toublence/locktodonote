    "onboarding.activate.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS zeigt die Karte bis zum Ende des Tages. Du kannst sie jederzeit neu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS mostrará la tarjeta hasta el final del día. Puedes reiniciarla cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS affiche la carte jusqu’à la fin de la journée. Vous pouvez la relancer quand vous voulez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS दिन खत्म होने तक कार्ड दिखाएगा। आप कभी भी दोबारा शुरू कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSが一日中カードを表示します。いつでも再開できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 하루 동안 카드를 보여줘요. 언제든 다시 시작할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会显示这张卡片直到今天结束，你随时可以重新开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 會顯示這張卡片直到今天結束，你隨時可以重新開啟。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ النشاط المباشر الحقيقي الآن. ويمكنك إعادة تشغيله في أي وقت."
          }
        }
      }
    },
    "onboarding.activate.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg sie auf den Sperrbildschirm"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponla en tu pantalla bloqueada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
