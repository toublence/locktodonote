    "template.imageMemo.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell ein Foto neben deine Notiz und mach den Sperrbildschirm zu deinem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon una foto junto a tu nota para que la pantalla bloqueada sea tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une photo à côté de votre note pour un écran verrouillé qui vous ressemble."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेमो के साथ फ़ोटो रखें और लॉक स्क्रीन को अपना बनाएँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモの横に写真を置いて、ロック画面を自分らしく。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모 옆에 사진을 두어 잠금화면을 나만의 것으로 만드세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在备忘旁放一张照片，让锁屏成为你的样子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在備忘旁放一張照片，讓鎖屏成為你的樣子。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإقران صورة مع مذكرتك حتى تبدو شاشة القفل وكأنها ملكك."
          }
        }
      }
    },
