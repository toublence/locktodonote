    "privacy.hiddenDetail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhalte werden ersetzt – praktisch, wenn andere auf deinen Bildschirm sehen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido se sustituye: útil si otras personas pueden ver tu pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu est remplacé — utile si d’autres peuvent voir votre écran."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामग्री छिप जाती है — तब उपयोगी जब दूसरे आपकी स्क्रीन देख सकते हों।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が隠されます。画面を他の人に見られる可能性があるときに便利です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용이 가려져요. 화면이 남에게 보일 수 있을 때 유용해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容会被遮盖——当他人可能看到你的屏幕时很有用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容會被遮蔽——當他人可能看到你的螢幕時很有用。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم استبدال المحتويات بعنصر نائب، وهو أمر مفيد إذا كان بإمكان الآخرين رؤية شاشتك."
          }
        }
      }
    },
