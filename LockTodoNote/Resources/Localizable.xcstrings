    "display.island.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island folgt der Live-Aktivität. Keine separate Einrichtung erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island sigue la Actividad en directo. No requiere configuración adicional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island suit l’activité en direct. Aucune configuration séparée n’est nécessaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island लाइव एक्टिविटी के साथ काम करता है। अलग सेटअप की ज़रूरत नहीं है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Islandはライブアクティビティに連動します。個別の設定は不要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵动岛会跟随实时活动，无需单独设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "動態島會跟隨即時動態，無需另外設定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island는 Live Activity와 함께 동작하며 별도 설정이 필요하지 않습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع الجزيرة الديناميكية النشاط المباشر. ليس هناك حاجة إلى إعداد منفصل."
          }
        }
      }
    },
