    "display.widget.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Heute-Karte bleibt verfügbar, nachdem eine Live-Aktivität endet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tarjeta Hoy seguirá disponible cuando termine una Actividad en directo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre carte Aujourd’hui reste disponible après la fin d’une activité en direct."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव एक्टिविटी खत्म होने के बाद भी आज का कार्ड उपलब्ध रहता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブアクティビティ終了後も「今日」カードを利用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时活动结束后，“今天”卡片仍可继续使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時動態結束後，「今天」卡片仍可繼續使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activity가 끝난 뒤에도 오늘 카드가 계속 표시됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل بطاقة اليوم الخاصة بك متاحة بعد انتهاء النشاط المباشر."
          }
        }
      }
    },
