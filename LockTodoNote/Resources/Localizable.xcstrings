    "onboarding.intro.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh Aufgaben und Notizen, ohne zu entsperren – und hak sie direkt dort ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta tus tareas y notas sin desbloquear, y márcalas ahí mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez vos tâches et notes sans déverrouiller, et cochez-les sur place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना अनलॉक किए आज के कार्य और मेमो देखें, और वहीं पूरा करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックを解除せずに今日のToDoとメモを確認し、その場で完了できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금을 풀지 않고 오늘의 할 일과 메모를 보고, 바로 완료 처리하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需解锁就能查看今天的待办和备忘，并直接勾选完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不必解鎖就能查看今天的待辦和備忘，並直接勾選完成。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلع على المهام والمذكرات اليومية دون فتح القفل، وقم بالتحقق منها هناك على الفور."
          }
        }
      }
    },
    "onboarding.intro.title": {
