    "onboarding.done.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperr dein iPhone, um sie zu sehen. Mehr fügst du in der App oder per Kurzbefehl hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea el iPhone para verla. Añade más desde la app o con Atajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillez votre iPhone pour la voir. Ajoutez-en d’autres depuis l’app ou Raccourcis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखने के लिए फ़ोन लॉक करें। ऐप या शॉर्टकट से और जोड़ें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面をロックすると表示されます。アプリやショートカットから追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 잠그면 바로 보여요. 앱이나 단축어로 더 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定手机即可看到。可从应用或快捷指令继续添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定手機即可看到。可從 App 或捷徑繼續新增。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قفل هاتفك لرؤية بطاقة اليوم."
          }
        }
      }
    },
