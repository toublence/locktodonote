    "liveActivity.staleDetail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS stoppt die Aktualisierung nach einigen Stunden. Starte sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS deja de actualizar la tarjeta tras unas horas. Vuelve a iniciarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS cesse de mettre à jour la carte après quelques heures. Relancez-la."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ घंटों बाद iOS कार्ड अपडेट करना बंद कर देता है। इसे दोबारा शुरू करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSは数時間経つとカードの更新を停止します。もう一度開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 몇 시간이 지나면 카드 업데이트를 멈춰요. 다시 시작해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "几小时后 iOS 会停止更新卡片，请重新开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幾小時後 iOS 會停止更新卡片，請重新開啟。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف نظام iOS عن التحديث بعد بضع ساعات. ابدأ تشغيله مرة أخرى."
          }
        }
      }
    },
