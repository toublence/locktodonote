    "template.memoTodo.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiz und Aufgaben auf einer Karte – umschaltbar, ohne zu entsperren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten una nota y tus tareas en una sola tarjeta, y cambia entre ellas sin desbloquear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réunissez note et tâches sur une carte, et passez de l’une à l’autre sans déverrouiller."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेमो और कार्य एक ही कार्ड पर रखें, और बिना अनलॉक किए बदलें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモとToDoを1枚のカードにまとめ、ロックを解除せずに切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모와 할 일을 한 카드에 두고, 잠금을 풀지 않고 전환하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把备忘和待办放在同一张卡片上，无需解锁即可切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把備忘和待辦放在同一張卡片上，不必解鎖即可切換。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بمذكرة ومهامك على بطاقة واحدة، وقم بالتبديل بينها دون فتح القفل."
          }
        }
      }
    },
