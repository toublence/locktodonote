    "template.ddayMemo.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zähl die Tage bis zum wichtigen Termin – mit Notiz daneben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta los días hasta la fecha que importa, con una nota al lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptez les jours jusqu’à la date qui compte, avec une note à côté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़रूरी दिन तक के दिन गिनें, साथ में एक नोट भी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大切な日までの残り日数を、メモと一緒に数えましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중요한 날까지 남은 일수를 메모와 함께 세어보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "倒数重要的日子，旁边还能写下备注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "倒數重要的日子，旁邊還能寫下備註。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بالعد التنازلي لليوم المهم، مع ملاحظة بجانبه."
          }
        }
      }
    },
