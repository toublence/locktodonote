    "settings.dataDetail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Karten bleiben in der vorhandenen LockTodoNote-App-Gruppe, damit deine Daten bei Updates erhalten bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus tarjetas permanecen en el grupo de apps de LockTodoNote para conservar tus datos tras las actualizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos cartes restent dans le groupe d’apps LockTodoNote existant afin de conserver vos données lors des mises à jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कार्ड मौजूदा LockTodoNote App Group में रहते हैं, इसलिए अपडेट के बाद भी डेटा सुरक्षित रहता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードは既存のLockTodoNote App Groupに保存されるため、アップデート後もデータが維持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的卡片会保留在现有的 LockTodoNote App Group 中，更新后数据仍会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的卡片會保留在現有的 LockTodoNote App Group 中，更新後資料仍會保留。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 LockTodoNote App Group에 카드를 그대로 보관해 업데이트 후에도 데이터가 유지됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل بطاقاتك في مجموعة تطبيقات LockTodoNote الحالية، لذا تحافظ التحديثات على بياناتك."
          }
        }
      }
    },
