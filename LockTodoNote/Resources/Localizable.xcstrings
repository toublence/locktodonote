    "display.island.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf unterstützten iPhones erscheint die aktuelle Live-Aktivität automatisch in der Dynamic Island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los iPhone compatibles, la Actividad en directo actual aparece automáticamente en Dynamic Island."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur les iPhone compatibles, l’activité en direct actuelle apparaît automatiquement dans Dynamic Island."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समर्थित iPhone पर मौजूदा लाइव एक्टिविटी अपने आप Dynamic Island में दिखाई देती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応するiPhoneでは、現在のライブアクティビティがDynamic Islandに自動表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在支持的 iPhone 上，当前实时活动会自动显示在灵动岛中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在支援的 iPhone 上，目前的即時動態會自動顯示在動態島中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되는 iPhone에서는 현재 Live Activity가 Dynamic Island에 자동으로 표시됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على أجهزة iPhone المدعومة، يظهر النشاط المباشر الحالي تلقائيًا في Dynamic Island."
          }
        }
      }
    },
