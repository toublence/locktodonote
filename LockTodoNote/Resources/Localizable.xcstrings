    "display.island.unavailableDevice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island ist auf diesem Gerät nicht verfügbar. Auf unterstützten iPhones wird es automatisch mit Live-Aktivität angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island no está disponible en este dispositivo. En iPhones compatibles, aparece automáticamente con Live Activity."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island n'est pas disponible sur cet appareil. Sur les iPhones pris en charge, il apparaît automatiquement avec Live Activity."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर डायनेमिक आइलैंड उपलब्ध नहीं है. समर्थित iPhones पर यह लाइव गतिविधि के साथ स्वचालित रूप से दिखाई देता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではダイナミック アイランドは利用できません。サポートされている iPhone では、ライブ アクティビティとともに自動的に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 Dynamic Island를 사용할 수 없습니다. 지원되는 iPhone에서는 실시간 활동과 함께 자동으로 나타납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动态岛在此设备上不可用。在支持的 iPhone 上，它会自动与实时活动一起显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "動態島在此裝置上不可用。在支援的 iPhone 上，它會自動與即時活動一起顯示。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جزيرة ديناميكية غير متوفرة على هذا الجهاز. على أجهزة iPhone المدعومة، يظهر تلقائيًا مع Live Activity."
          }
        }
      }
    },
