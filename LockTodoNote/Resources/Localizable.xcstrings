    "settings.migrationFailed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine bisherigen Daten konnten noch nicht gelesen werden. Sie sind weiterhin gespeichert und werden beim nächsten Start erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se han podido leer tus datos anteriores. Siguen guardados y se reintentará al abrir la app de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données précédentes n’ont pas encore pu être lues. Elles sont toujours enregistrées et seront réessayées au prochain lancement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पुराना डेटा अभी पढ़ा नहीं जा सका। वह सुरक्षित है और अगली बार फिर कोशिश की जाएगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のデータをまだ読み込めていません。データは残っており、次回起動時に再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 데이터를 아직 불러오지 못했어요. 데이터는 그대로 있으며 다음 실행에서 다시 시도해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法读取你之前的数据。数据仍在，下次启动会再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法讀取你先前的資料。資料仍在，下次啟動會再試。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن قراءة بياناتك السابقة بعد. لا يزال محفوظًا وستتم إعادة المحاولة عند الإطلاق التالي."
          }
        }
      }
    },
