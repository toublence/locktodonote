    "settings.languageDetail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LockTodoNote verwendet die in den iOS-Einstellungen für die App gewählte Sprache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LockTodoNote usa el idioma seleccionado para la app en los ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LockTodoNote utilise la langue choisie pour l’app dans les réglages iOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "LockTodoNote iOS सेटिंग्स में ऐप के लिए चुनी गई भाषा का उपयोग करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LockTodoNoteはiOS設定でアプリに選択された言語を使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LockTodoNote 使用 iOS 设置中为该 App 选择的语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LockTodoNote 使用 iOS 設定中為此 App 選擇的語言。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LockTodoNote는 iOS 설정에서 앱에 지정한 언어를 사용합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع النظام الافتراضي اللغة المحددة للتطبيق في إعدادات iOS."
          }
        }
      }
    },
