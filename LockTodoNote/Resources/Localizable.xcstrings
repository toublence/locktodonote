    "settings.shortcutsLimited": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis sind 5 Einträge pro Tag. Bei gemischten Vorlagen entscheidet diese Einstellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión gratuita permite 5 al día. En plantillas mixtas, este ajuste decide dónde se guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite permet 5 ajouts par jour. Pour les modèles mixtes, ce réglage décide de la destination."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त में दिन में 5 बार। मिश्रित टेम्पलेट में यह सेटिंग तय करती है कि कहाँ सेव हो।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版は1日5回まで追加できます。混合テンプレートではこの設定に従って保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료는 하루 5회까지 추가할 수 있어요. 혼합 템플릿에서는 이 설정에 따라 저장돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版每天可添加 5 次。混合模板会按此设置决定保存位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費版每天可新增 5 次。混合範本會依此設定決定儲存位置。"
          }
        },
        "ar": {
