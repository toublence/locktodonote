          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette modification n’a pas pu être enregistrée. Rouvrez l’app avant de continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बदलाव सेव नहीं हो सका। आगे बदलाव करने से पहले ऐप दोबारा खोलें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を保存できませんでした。アプリを開き直してから編集してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 저장하지 못했어요. 앱을 다시 연 뒤에 수정해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次更改未能保存。请重新打开应用后再编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
