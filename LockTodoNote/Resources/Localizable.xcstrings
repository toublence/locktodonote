          "stringUnit": {
            "state": "translated",
            "value": "Cuando finalice la actividad en vivo, continúa tu día en el widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque l'activité en direct se termine, continuez votre journée dans le widget."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब लाइव गतिविधि समाप्त हो जाए, तो विजेट में अपना दिन जारी रखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ アクティビティが終了したら、ウィジェットで 1 日を続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브 활동이 종료되면 위젯에서 하루를 계속하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时活动结束后，在小部件中继续您的一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實時活動結束後，在小部件中繼續您的一天。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما ينتهي النشاط المباشر، واصل يومك في الأداة."
          }
        }
      }
    },
